<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Category / privilege (Odoo 19 groups UI) ─────────────────── -->
    <record id="module_category_fawtara" model="ir.module.category">
        <field name="name">Fawtara E-Invoicing</field>
        <field name="sequence">60</field>
    </record>

    <record id="res_groups_privilege_fawtara" model="res.groups.privilege">
        <field name="name">Fawtara</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_fawtara"/>
    </record>

    <!-- Baramej internal staff — full ASP back office (clients, billing,
         all invoices of all companies). Client users must NEVER get this. -->
    <record id="group_fawtara_admin" model="res.groups">
        <field name="name">Baramej ASP Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_fawtara"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Baramej staff: onboard clients, manage billing, see every client's invoices.</field>
    </record>

    <!-- ── Record rules: admins see everything, across companies ────── -->
    <record id="rule_fawtara_client_admin" model="ir.rule">
        <field name="name">Fawtara client: ASP admin — all</field>
        <field name="model_id" ref="model_fawtara_client"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_fawtara_admin'))]"/>
    </record>

    <record id="rule_fawtara_invoice_admin" model="ir.rule">
        <field name="name">Fawtara invoice: ASP admin — all</field>
        <field name="model_id" ref="model_fawtara_invoice"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_fawtara_admin'))]"/>
    </record>

    <record id="rule_fawtara_invoice_line_admin" model="ir.rule">
        <field name="name">Fawtara invoice line: ASP admin — all</field>
        <field name="model_id" ref="model_fawtara_invoice_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_fawtara_admin'))]"/>
    </record>

    <record id="rule_fawtara_subscription_admin" model="ir.rule">
        <field name="name">Fawtara subscription: ASP admin — all</field>
        <field name="model_id" ref="model_fawtara_client_subscription"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_fawtara_admin'))]"/>
    </record>

</odoo>
