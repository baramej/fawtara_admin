<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Fawtara API configuration — edit in Settings > Technical > Parameters -->
        <record id="param_fawtara_api_url"
                model="ir.config_parameter">
            <field name="key">fawtara.api_url</field>
            <field name="value">http://localhost:8081</field>
        </record>

        <record id="param_fawtara_admin_key"
                model="ir.config_parameter">
            <field name="key">fawtara.admin_api_key</field>
            <field name="value">fwt_admin_baramej2026sec</field>
        </record>

        <record id="param_fawtara_docs_url"
                model="ir.config_parameter">
            <field name="key">fawtara.docs_url</field>
            <field name="value">https://docs.fawtara.baramej.om</field>
        </record>

        <record id="param_fawtara_sandbox_url"
                model="ir.config_parameter">
            <field name="key">fawtara.sandbox_url</field>
            <field name="value">https://sandbox.fawtara.baramej.om</field>
        </record>

        <record id="param_fawtara_webhook_key"
                model="ir.config_parameter">
            <field name="key">fawtara.webhook_key</field>
            <field name="value">fawtara-webhook-secret-2026</field>
        </record>

        <!-- Billing Plans -->
        <record id="plan_starter" model="fawtara.billing.plan">
            <field name="name">Starter</field>
            <field name="quota_invoices">10000</field>
            <field name="price_omr">1500.000</field>
            <field name="overage_rate_bzs">50.0</field>
            <field name="billing_cycle">monthly</field>
            <field name="description">Up to 10,000 invoices per month</field>
        </record>

        <record id="plan_business" model="fawtara.billing.plan">
            <field name="name">Business</field>
            <field name="quota_invoices">50000</field>
            <field name="price_omr">7500.000</field>
            <field name="overage_rate_bzs">50.0</field>
            <field name="billing_cycle">monthly</field>
            <field name="description">Up to 50,000 invoices per month</field>
        </record>

        <record id="plan_enterprise" model="fawtara.billing.plan">
            <field name="name">Enterprise</field>
            <field name="quota_invoices">200000</field>
            <field name="price_omr">25000.000</field>
            <field name="overage_rate_bzs">40.0</field>
            <field name="billing_cycle">monthly</field>
            <field name="description">Up to 200,000 invoices per month</field>
        </record>

    </data>
</odoo>